# Database URL (Defaults to local SQLite if not set)
# For production PostgreSQL (Render/Railway/Supabase/Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./private_chat.db

# JWT Secret Key (Generate a secure 32+ character random string in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters

# JWT Expiration in minutes (7 days = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie Configuration
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Allowed CORS Origins (comma-separated or list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
