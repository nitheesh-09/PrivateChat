# ==========================================
# PRIVATE CHAT ENVIRONMENT CONFIGURATION
# ==========================================

# --- Backend Configuration ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname  # Production PostgreSQL
DATABASE_URL=sqlite:///./private_chat.db                    # Local SQLite fallback
JWT_SECRET=replace_with_a_secure_32_character_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configuration ---
# Set these in your frontend environment (or frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
